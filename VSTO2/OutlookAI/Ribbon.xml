<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
	<ribbon>
		<tabs>
			<!-- Phase 2: compose-window ribbon button. -->
			<tab idMso="TabNewMailMessage">
				<group id="AIAssistantGroup" label="AI-помощник" insertAfterMso="GroupClipboard">
					<button id="btnAIAssistant"
							label="AI-помощник"
							size="large"
							onAction="OnAIAssistantClick"
							supertip="Открыть AI-помощника для проверки, редактирования и написания писем."
							imageMso="SmartArtChangeColorsGallery" />
					<button id="btnSettingsCompose"
							label="Настройки"
							size="large"
							onAction="OnSettingsClick"
							supertip="Открыть настройки OutlookAI и ввести ключ API LiteLLM."
							imageMso="FileProperties" />
				</group>
			</tab>
			<!-- Phase 3a: Explorer ribbon button (Inbox view). Same onAction
			     handler; ThisAddIn.ShowTaskPane context-routes based on
			     Application.ActiveWindow(). -->
			<tab idMso="TabMail">
				<group id="AIAssistantExplorerGroup" label="AI-помощник" insertAfterMso="GroupMailMove">
					<button id="btnAIAssistantExplorer"
							label="AI-помощник"
							size="large"
							onAction="OnAIAssistantClick"
							supertip="Открыть AI-помощника для работы с почтой: поиск, сводки и действия с сообщениями."
							imageMso="SmartArtChangeColorsGallery" />
					<button id="btnReports"
							label="Отчёты"
							size="large"
							onAction="OnReportsClick"
							supertip="Открыть панель отчётов по почте: дайджесты, задачи, сводки переписок и статистика."
							imageMso="PivotTableInsert" />
					<button id="btnSettingsExplorer"
							label="Настройки"
							size="large"
							onAction="OnSettingsClick"
							supertip="Открыть настройки OutlookAI и ввести ключ API LiteLLM."
							imageMso="FileProperties" />
				</group>
			</tab>
		</tabs>
	</ribbon>
</customUI>
