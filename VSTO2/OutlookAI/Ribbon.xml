<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_Load">
	<ribbon>
		<tabs>
			<!-- Phase 2: compose-window ribbon button. -->
			<tab idMso="TabNewMailMessage">
				<group id="AIAssistantGroup" label="AI-помощник" insertAfterMso="GroupClipboard">
					<dynamicMenu id="selectionActionsCompose" label="Изменить выделение" size="large"
						getContent="GetSelectionMenuContent" invalidateContentOnDrop="true" imageMso="EditText" />
					<button id="btnAIAssistant"
							label="AI-помощник"
							size="large"
							onAction="OnAIAssistantClick"
							supertip="Открыть AI-помощника для проверки, редактирования и написания писем."
							imageMso="SmartArtChangeColorsGallery" />
					<button id="btnSettingsCompose"
							label="Настройки"
							size="large"
							onAction="OnSettingsClick"
							supertip="Открыть настройки OutlookAI и ввести ключ API LiteLLM."
							imageMso="FileProperties" />
				</group>
			</tab>
			<!-- Phase 3a: Explorer ribbon button (Inbox view). Same onAction
			     handler; ThisAddIn.ShowTaskPane context-routes based on
			     Application.ActiveWindow(). -->
			<tab idMso="TabMail">
				<group id="AIAssistantExplorerGroup" label="AI-помощник" insertAfterMso="GroupMailMove">
					<button id="btnAIAssistantExplorer"
							label="AI-помощник"
							size="large"
							onAction="OnAIAssistantClick"
							supertip="Открыть AI-помощника для работы с почтой: поиск, сводки и действия с сообщениями."
							imageMso="SmartArtChangeColorsGallery" />
					<button id="btnReports"
							label="Отчёты"
							size="large"
							onAction="OnReportsClick"
							supertip="Открыть панель отчётов по почте: дайджесты, задачи, сводки переписок и статистика."
							imageMso="PivotTableInsert" />
					<button id="btnSettingsExplorer"
							label="Настройки"
							size="large"
							onAction="OnSettingsClick"
							supertip="Открыть настройки OutlookAI и ввести ключ API LiteLLM."
							imageMso="FileProperties" />
				</group>
			</tab>
			<tab idMso="TabAppointment">
				<group id="AIAssistantAppointmentGroup" label="AI-помощник">
					<dynamicMenu id="selectionActionsAppointment" label="Изменить выделение" size="large"
						getContent="GetSelectionMenuContent" invalidateContentOnDrop="true" imageMso="EditText" />
					<button id="btnAIAssistantAppointment"
							label="AI-помощник"
							size="large"
							onAction="OnAIAssistantClick"
							supertip="Открыть AI-помощника и настроить действия для выделенного текста."
							imageMso="SmartArtChangeColorsGallery" />
					<button id="btnSettingsAppointment"
							label="Настройки"
							size="large"
							onAction="OnSettingsClick"
							supertip="Открыть настройки OutlookAI."
							imageMso="FileProperties" />
				</group>
			</tab>
			<tab idMso="TabTask">
				<group id="AIAssistantTaskGroup" label="AI-помощник">
					<dynamicMenu id="selectionActionsTask" label="Изменить выделение" size="large"
						getContent="GetSelectionMenuContent" invalidateContentOnDrop="true" imageMso="EditText" />
					<button id="btnAIAssistantTask"
							label="AI-помощник"
							size="large"
							onAction="OnAIAssistantClick"
							supertip="Открыть AI-помощника и настроить действия для выделенного текста."
							imageMso="SmartArtChangeColorsGallery" />
					<button id="btnSettingsTask"
							label="Настройки"
							size="large"
							onAction="OnSettingsClick"
							supertip="Открыть настройки OutlookAI."
							imageMso="FileProperties" />
				</group>
			</tab>
			<tab idMso="TabReadMessage">
				<group id="AIAssistantReadGroup" label="AI-помощник">
					<button id="btnAIAssistantRead" label="Анализ письма" size="large"
						onAction="OnAIAssistantClick" imageMso="SmartArtChangeColorsGallery" />
				</group>
			</tab>
		</tabs>
	</ribbon>
	<contextMenus>
		<contextMenu idMso="ContextMenuText">
			<dynamicMenu id="outlookAiSelectionMenu"
						 label="AI-ассистент"
						 imageMso="SmartArtChangeColorsGallery"
						 getVisible="GetSelectionMenuVisible"
						 getContent="GetSelectionMenuContent"
						 invalidateContentOnDrop="true" />
		</contextMenu>
	</contextMenus>
</customUI>
